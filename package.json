{
  "name": "leaf_server",
  "version": "1.0.0",
  "description": "Server for Leaf game",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm install && tsc",
    "start": "node dist/server.js",
    "dev": "tsc && nodemon dist/server.js",
    "dev:watch": "tsc --watch",
    "test": "NODE_ENV=test jest --coverage",
    "test:coverage": "NODE_ENV=test jest --coverage --forceExit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "CC0-1.0",
  "dependencies": {
    "@hiveio/dhive": "^1.3.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "socket.io": "^4.8.3"
  },
  "overrides": {
    "ws": "^8.21.0",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "typescript": "^6.0.3"
  }
}
